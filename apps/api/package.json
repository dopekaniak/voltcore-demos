{
  "name": "@sw/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@sw/config": "workspace:*",
    "@sw/db": "workspace:*",
    "@sw/shared": "workspace:*",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "zod": "4.6.7",
    "@sw/forge-kit": "workspace:*",
    "@sw/storage": "workspace:*",
    "@sw/providers": "workspace:*",
    "@sw/pricing": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./testing": "./test/helpers.ts"
  }
}
