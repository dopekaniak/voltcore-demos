{
  "name": "@sw/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sw/config": "workspace:*",
    "@sw/db": "workspace:*",
    "@sw/shared": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
