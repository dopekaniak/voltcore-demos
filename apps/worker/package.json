{
  "name": "@sw/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sw/config": "workspace:*",
    "@sw/db": "workspace:*",
    "@sw/forge-kit": "workspace:*",
    "@sw/providers": "workspace:*",
    "@sw/shared": "workspace:*",
    "@sw/storage": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nodemailer": "7.0.13"
  },
  "devDependencies": {
    "@sw/api": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
