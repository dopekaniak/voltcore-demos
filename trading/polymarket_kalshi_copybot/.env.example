# Polymarket -> Kalshi copy bot. Copy to .env in this folder (never commit .env or your .pem key).
# Values here override nothing in the repo-root .env; the bot reads this folder's .env first, then the root one.

# ---------------------------------------------------------------- mode & Kalshi account
# paper = simulated fills against the live Kalshi order book (no account needed). live = real orders.
MODE=paper
# Live trading also requires this exact phrase. Leave blank to stay safe.
LIVE_TRADING_CONFIRM=
# prod or demo. Paper mode needs no key and should read real prod prices. Before going live, point
# this at demo (Kalshi's fake-money sandbox, separate keys) with MODE=live to rehearse real order flow.
KALSHI_ENV=prod
# Kalshi -> Account & security -> API Keys. Save the downloaded private key outside the repo.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/kalshi_private_key.pem

# ---------------------------------------------------------------- which Polymarket traders to follow
LEADER_TOP_N=20
# day | week | month | all
LEADER_TIME_PERIOD=month
# overall, or a Polymarket category such as politics, sports, crypto
LEADER_CATEGORY=overall
LEADER_MIN_PNL=10000
LEADER_MIN_VOLUME=0
LEADER_REFRESH_MIN=60
# Comma-separated proxy wallets to always follow / never follow
LEADER_WALLETS_EXTRA=
LEADER_WALLETS_EXCLUDE=

# ---------------------------------------------------------------- which of their trades to copy
POLL_INTERVAL_SEC=30
# Ignore leader buys smaller than this (filters noise and market-making churn)
MIN_LEADER_TRADE_USD=500
# Ignore leader fills older than this when we see them
MAX_TRADE_AGE_SEC=600
MIN_ENTRY_PRICE=0.05
MAX_ENTRY_PRICE=0.95
# Do not open positions this close to Kalshi close/expiry
MIN_MINUTES_TO_CLOSE=30
# Skip markets whose slug contains any of these (ultra-short crypto markets are pure latency games)
SKIP_SLUG_PATTERNS=updown,up-or-down,-5m-,-15m-
# Mirror leader exits proportionally
COPY_SELLS=true

# ---------------------------------------------------------------- market matching
# Auto-trade only clear matches; between the two thresholds a match goes to the review queue.
MATCH_AUTO_THRESHOLD=0.80
MATCH_REVIEW_THRESHOLD=0.65
MATCH_MAX_DATE_DIFF_DAYS=7
KALSHI_UNIVERSE_REFRESH_MIN=60
# Optional LLM second opinion for unclear matches via local OmniRoute: off | review | all
LLM_VERIFY_MODE=off
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
LLM_MODEL=auto
LLM_MIN_CONFIDENCE=0.8

# ---------------------------------------------------------------- sizing & hard risk caps
# fixed = COPY_USD_PER_TRADE each time; proportional = leader dollars * COPY_RATIO
COPY_SIZING=fixed
COPY_USD_PER_TRADE=10
COPY_RATIO=0.001
MIN_ORDER_USD=1
MAX_ORDER_USD=25
# Max % of equity per order
MAX_RISK_PCT_PER_TRADE=1
# Max cents (as dollars) we pay above the leader's Polymarket fill price
MAX_PRICE_GAP=0.03
MAX_POSITION_USD_PER_MARKET=50
MAX_TOTAL_EXPOSURE_USD=250
MAX_DAILY_SPEND_USD=100
# Stop opening positions for the day when equity falls this % below the day's start
DAILY_LOSS_LIMIT_PCT=3
MAX_ORDERS_PER_HOUR=20
MAX_OPEN_POSITIONS=15
# How far below the bid we accept when mirroring an exit
EXIT_SLIPPAGE=0.05
PAPER_STARTING_BALANCE=1000

# ---------------------------------------------------------------- ops
# Optional uptime ping each cycle (e.g. a healthchecks.io URL)
HEALTHCHECK_URL=
LOG_LEVEL=INFO
# COPYBOT_DATA_DIR=./data
