// Shapewright data model, Release 1 core tables (build prompt section 7).
// IDs are UUIDv7 generated by the client; the API renders them with type prefixes.
// Constraints Prisma cannot express (CHECKs, append-only triggers, partial and trigram
// indexes) live in the migration SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  USER
  ADMIN
  OPS
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique @db.Citext
  name          String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  termsVersion  String?    @map("terms_version")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  totpSecretEnc String?    @map("totp_secret_enc")
  totpEnabledAt DateTime?  @map("totp_enabled_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions         Session[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  wallet           CreditWallet?
  subscriptions    Subscription[]
  assets           Asset[]
  jobs             Job[]
  printParts       PrintPart[]
  quotes           Quote[]
  cart             Cart?
  addresses        Address[]
  orders           Order[]
  uploads          Upload[]

  @@map("users")
}

model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  totpVerifiedAt DateTime? @map("totp_verified_at")
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MagicLink {
  id         String    @id @default(uuid(7)) @db.Uuid
  email      String    @db.Citext
  tokenHash  String    @unique @map("token_hash")
  anonId     String?   @map("anon_id")
  redirectTo String?   @map("redirect_to")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("magic_links")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  name       String
  prefix     String    @unique
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("api_keys")
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

model WebhookEndpoint {
  id         String                @id @default(uuid(7)) @db.Uuid
  ownerId    String                @map("owner_id") @db.Uuid
  url        String
  secretEnc  String                @map("secret_enc")
  events     String[]
  status     WebhookEndpointStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  owner      User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([ownerId])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@map("webhook_deliveries")
}

// ───────────────────────────── Money ─────────────────────────────

model CreditWallet {
  id        String         @id @default(uuid(7)) @db.Uuid
  ownerId   String         @unique @map("owner_id") @db.Uuid
  balance   Int            @default(0)
  reserved  Int            @default(0)
  updatedAt DateTime       @updatedAt @map("updated_at")
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ledger    CreditLedger[]
  grants    CreditGrant[]
  reservations Reservation[]

  @@map("credit_wallets")
}

enum LedgerKind {
  GRANT
  PURCHASE
  RESERVE
  COMMIT
  RELEASE
  EXPIRE
  ADJUST
  REFUND
}

/// Append-only: a trigger rejects UPDATE and DELETE. balance == sum(delta).
model CreditLedger {
  id             String     @id @default(uuid(7)) @db.Uuid
  walletId       String     @map("wallet_id") @db.Uuid
  kind           LedgerKind
  delta          Int
  reservedDelta  Int        @default(0) @map("reserved_delta")
  balanceAfter   Int        @map("balance_after")
  reservedAfter  Int        @map("reserved_after")
  idempotencyKey String     @unique @map("idempotency_key")
  reservationId  String?    @map("reservation_id") @db.Uuid
  jobId          String?    @map("job_id") @db.Uuid
  grantId        String?    @map("grant_id") @db.Uuid
  reason         String?
  actorId        String?    @map("actor_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  wallet         CreditWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@map("credit_ledger")
}

enum GrantSource {
  PLAN
  PACK
  ADMIN
  SIGNUP
}

/// A bucket of credits. Monthly plan grants expire at period end; packs never expire.
model CreditGrant {
  id        String      @id @default(uuid(7)) @db.Uuid
  walletId  String      @map("wallet_id") @db.Uuid
  source    GrantSource
  amount    Int
  remaining Int
  expiresAt DateTime?   @map("expires_at")
  sourceRef String?     @map("source_ref")
  createdAt DateTime    @default(now()) @map("created_at")
  wallet    CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, source, sourceRef])
  @@index([walletId, expiresAt])
  @@map("credit_grants")
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

model Reservation {
  id              String            @id @default(uuid(7)) @db.Uuid
  walletId        String            @map("wallet_id") @db.Uuid
  amount          Int
  committedAmount Int?              @map("committed_amount")
  status          ReservationStatus @default(RESERVED)
  jobId           String?           @unique @map("job_id") @db.Uuid
  expiresAt       DateTime          @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  wallet          CreditWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("reservations")
}

model Plan {
  id                 String  @id @default(uuid(7)) @db.Uuid
  code               String  @unique
  name               String
  monthlyCredits     Int     @map("monthly_credits")
  priceMinor         Int     @map("price_minor")
  currency           String  @default("USD")
  apiRateLimitPerMin Int     @map("api_rate_limit_per_min")
  stripePriceId      String? @map("stripe_price_id")
  active             Boolean @default(true)
  sortOrder          Int     @default(0) @map("sort_order")
  subscriptions      Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(uuid(7)) @db.Uuid
  ownerId              String             @map("owner_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  owner                User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([ownerId])
  @@map("subscriptions")
}

model CreditPack {
  id            String  @id @default(uuid(7)) @db.Uuid
  code          String  @unique
  name          String
  credits       Int
  priceMinor    Int     @map("price_minor")
  currency      String  @default("USD")
  stripePriceId String? @map("stripe_price_id")
  active        Boolean @default(true)

  @@map("credit_packs")
}

enum PaymentKind {
  ORDER
  CREDIT_PACK
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  ownerId               String        @map("owner_id") @db.Uuid
  kind                  PaymentKind
  status                PaymentStatus @default(PENDING)
  amountMinor           Int           @map("amount_minor")
  currency              String
  refundedMinor         Int           @default(0) @map("refunded_minor")
  stripeSessionId       String?       @unique @map("stripe_session_id")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String?       @unique @map("stripe_invoice_id")
  orderId               String?       @map("order_id") @db.Uuid
  creditPackId          String?       @map("credit_pack_id") @db.Uuid
  idempotencyKey        String        @unique @map("idempotency_key")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  refunds               Refund[]

  @@index([ownerId])
  @@map("payments")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid
  amountMinor    Int          @map("amount_minor")
  currency       String
  reason         String
  status         RefundStatus @default(REQUESTED)
  requestedById  String       @map("requested_by_id") @db.Uuid
  approvedById   String?      @map("approved_by_id") @db.Uuid
  needsSecondApproval Boolean @default(false) @map("needs_second_approval")
  idempotencyKey String       @unique @map("idempotency_key")
  stripeRefundId String?      @unique @map("stripe_refund_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  payment        Payment      @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

// ───────────────────────────── Assets ─────────────────────────────

enum AssetKind {
  GENERATED
  FORGE
  UPLOAD
  PRINT_PART
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Asset {
  id               String     @id @default(uuid(7)) @db.Uuid
  ownerId          String     @map("owner_id") @db.Uuid
  kind             AssetKind
  title            String
  prompt           String?
  visibility       Visibility @default(PRIVATE)
  license          String     @default("ALL-RIGHTS-RESERVED")
  currentVersionId String?    @map("current_version_id") @db.Uuid
  forkedFromId     String?    @map("forked_from_id") @db.Uuid
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions         AssetVersion[]

  @@index([ownerId, kind, createdAt])
  @@map("assets")
}

enum VersionStage {
  PREVIEW
  REFINED
  RETEXTURED
  REMESHED
  REPAIRED
  FORGE
  UPLOAD
}

model AssetVersion {
  id              String       @id @default(uuid(7)) @db.Uuid
  assetId         String       @map("asset_id") @db.Uuid
  number          Int
  stage           VersionStage
  provider        String?
  modelCode       String?      @map("model_code")
  parentVersionId String?      @map("parent_version_id") @db.Uuid
  jobId           String?      @map("job_id") @db.Uuid
  triangles       Int?
  bboxMm          Json?        @map("bbox_mm")
  isWatertight    Boolean?     @map("is_watertight")
  analysis        Json?
  params          Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  files           AssetFile[]
  forgeSource     ForgeSource?

  @@unique([assetId, number])
  @@map("asset_versions")
}

enum FileRole {
  SOURCE
  PREVIEW_MESH
  GLB
  STL
  THREEMF
  STEP
  OBJ
  THUMBNAIL
  TEXTURE
  REPAIRED
}

model AssetFile {
  id             String        @id @default(uuid(7)) @db.Uuid
  ownerId        String?       @map("owner_id") @db.Uuid
  assetVersionId String?       @map("asset_version_id") @db.Uuid
  role           FileRole
  storageKey     String        @unique @map("storage_key")
  contentType    String        @map("content_type")
  filename       String
  sha256         String?
  bytes          Int
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  assetVersion   AssetVersion? @relation(fields: [assetVersionId], references: [id], onDelete: Cascade)

  @@index([assetVersionId])
  @@index([expiresAt])
  @@map("asset_files")
}

enum ForgeBuildState {
  DRAFT
  AUTHORING
  STATIC_CHECK
  BUILDING
  VERIFYING
  READY
  FAILED
}

model ForgeSource {
  id             String          @id @default(uuid(7)) @db.Uuid
  assetVersionId String          @unique @map("asset_version_id") @db.Uuid
  code           String
  schema         Json
  defaults       Json
  author         String
  authorVersion  String          @map("author_version")
  templateKey    String?         @map("template_key")
  dfmProfile     String          @map("dfm_profile")
  checks         Json?
  buildState     ForgeBuildState @default(DRAFT) @map("build_state")
  error          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  assetVersion   AssetVersion    @relation(fields: [assetVersionId], references: [id], onDelete: Cascade)

  @@map("forge_sources")
}

// ───────────────────────────── Jobs ─────────────────────────────

enum JobKind {
  GENERATE
  REFINE
  RETEXTURE
  REMESH
  FORGE_BUILD
  FORGE_EXPORT
  MESH_ANALYZE
  PRINT_QUOTE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  RETRYING
  FAILED
  CANCELED
}

model Job {
  id               String           @id @default(uuid(7)) @db.Uuid
  ownerId          String?          @map("owner_id") @db.Uuid
  anonId           String?          @map("anon_id")
  kind             JobKind
  status           JobStatus        @default(QUEUED)
  forgeState       ForgeBuildState? @map("forge_state")
  progress         Int              @default(0)
  attempt          Int              @default(0)
  maxAttempts      Int              @default(3) @map("max_attempts")
  parentJobId      String?          @map("parent_job_id") @db.Uuid
  idempotencyKey   String           @map("idempotency_key")
  providerKey      String?          @map("provider_key")
  providerTaskId   String?          @map("provider_task_id")
  modelCode        String?          @map("model_code")
  input            Json
  output           Json?
  assetId          String?          @map("asset_id") @db.Uuid
  assetVersionId   String?          @map("asset_version_id") @db.Uuid
  errorCode        String?          @map("error_code")
  errorMessage     String?          @map("error_message")
  reservedCredits  Int              @default(0) @map("reserved_credits")
  committedCredits Int              @default(0) @map("committed_credits")
  reservationId    String?          @map("reservation_id") @db.Uuid
  lockedBy         String?          @map("locked_by")
  lockedAt         DateTime?        @map("locked_at")
  nextRunAt        DateTime?        @map("next_run_at")
  timeoutAt        DateTime?        @map("timeout_at")
  startedAt        DateTime?        @map("started_at")
  finishedAt       DateTime?        @map("finished_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  owner            User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent           Job?             @relation("JobChildren", fields: [parentJobId], references: [id])
  children         Job[]            @relation("JobChildren")
  events           JobEvent[]

  @@unique([ownerId, idempotencyKey])
  @@unique([anonId, idempotencyKey])
  @@index([providerKey, providerTaskId])
  @@index([ownerId, createdAt])
  @@map("jobs")
}

/// Append-only. `seq` is the SSE event id (Last-Event-ID).
model JobEvent {
  seq        BigInt     @id @default(autoincrement())
  jobId      String     @map("job_id") @db.Uuid
  type       String
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus? @map("to_status")
  progress   Int?
  data       Json?
  createdAt  DateTime   @default(now()) @map("created_at")
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, seq])
  @@map("job_events")
}

model OutboxMessage {
  id          BigInt    @id @default(autoincrement())
  topic       String
  key         String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([topic, key])
  @@map("outbox_messages")
}

// ───────────────────────────── Print ─────────────────────────────

model Material {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique
  name       String
  colors     String[]
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("materials")
}

enum UploadPurpose {
  PRINT
  IMAGE
}

enum UploadStatus {
  PENDING
  UPLOADED
  SCANNING
  CLEAN
  REJECTED
}

model Upload {
  id           String        @id @default(uuid(7)) @db.Uuid
  ownerId      String?       @map("owner_id") @db.Uuid
  anonId       String?       @map("anon_id")
  purpose      UploadPurpose
  filename     String
  contentType  String        @map("content_type")
  bytes        Int
  storageKey   String        @unique @map("storage_key")
  status       UploadStatus  @default(PENDING)
  rejectReason String?       @map("reject_reason")
  sha256       String?
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("uploads")
}

enum PrintPartStatus {
  UPLOADED
  SCANNING
  ANALYZING
  NEEDS_REPAIR
  REPAIRING
  READY
  REJECTED
}

model PrintPart {
  id                     String          @id @default(uuid(7)) @db.Uuid
  ownerId                String?         @map("owner_id") @db.Uuid
  anonId                 String?         @map("anon_id")
  title                  String
  status                 PrintPartStatus @default(UPLOADED)
  uploadId               String?         @map("upload_id") @db.Uuid
  assetVersionId         String?         @map("asset_version_id") @db.Uuid
  forgeVersionId         String?         @map("forge_version_id") @db.Uuid
  sourceFileId           String?         @map("source_file_id") @db.Uuid
  repairedFileId         String?         @map("repaired_file_id") @db.Uuid
  useRepaired            Boolean         @default(false) @map("use_repaired")
  validationReport       Json?           @map("validation_report")
  repairReport           Json?           @map("repair_report")
  analysis               Json?
  settings               Json
  checksFailing          Boolean         @default(false) @map("checks_failing")
  catalogPartId          String?         @map("catalog_part_id") @db.Uuid
  fitAcknowledgedAt      DateTime?       @map("fit_acknowledged_at")
  checksAcknowledgedAt   DateTime?       @map("checks_acknowledged_at")
  expiresAt              DateTime?       @map("expires_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  owner                  User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes                 Quote[]

  @@index([anonId])
  @@map("print_parts")
}

enum QuoteStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  ORDERED
}

model Quote {
  id             String      @id @default(uuid(7)) @db.Uuid
  ownerId        String?     @map("owner_id") @db.Uuid
  anonId         String?     @map("anon_id")
  printPartId    String      @map("print_part_id") @db.Uuid
  inputsHash     String      @map("inputs_hash")
  inputs         Json
  lines          Json
  subtotalMinor  Int         @map("subtotal_minor")
  shippingMinor  Int         @map("shipping_minor")
  taxMinor       Int         @map("tax_minor")
  totalMinor     Int         @map("total_minor")
  currency       String
  pricingVersion Int         @map("pricing_version")
  isEstimate     Boolean     @map("is_estimate")
  leadTimeDays   Int         @map("lead_time_days")
  status         QuoteStatus @default(ACTIVE)
  idempotencyKey String?     @map("idempotency_key")
  expiresAt      DateTime    @map("expires_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  owner          User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  printPart      PrintPart   @relation(fields: [printPartId], references: [id], onDelete: Cascade)

  @@index([printPartId, createdAt])
  @@map("quotes")
}

model Cart {
  id        String     @id @default(uuid(7)) @db.Uuid
  ownerId   String     @unique @map("owner_id") @db.Uuid
  currency  String     @default("USD")
  updatedAt DateTime   @updatedAt @map("updated_at")
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  cartId      String   @map("cart_id") @db.Uuid
  printPartId String   @map("print_part_id") @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, printPartId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  name       String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String   @map("postal_code")
  country    String
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

enum OrderSource {
  UPLOAD
  LISTING
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  ON_HOLD
  SHIPPED
  DELIVERED
  EXPIRED
  CANCELED
  REFUNDING
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  ownerId         String      @map("owner_id") @db.Uuid
  source          OrderSource @default(UPLOAD)
  status          OrderStatus @default(DRAFT)
  subtotalMinor   Int         @map("subtotal_minor")
  shippingMinor   Int         @map("shipping_minor")
  taxMinor        Int         @map("tax_minor")
  totalMinor      Int         @map("total_minor")
  currency        String
  shippingMethod  String      @map("shipping_method")
  address         Json
  termsVersion    String      @map("terms_version")
  isEstimate      Boolean     @default(false) @map("is_estimate")
  stripeSessionId String?     @unique @map("stripe_session_id")
  idempotencyKey  String      @map("idempotency_key")
  paidAt          DateTime?   @map("paid_at")
  routedAt        DateTime?   @map("routed_at")
  problemReport   Json?       @map("problem_report")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  events          OrderEvent[]
  shipments       Shipment[]

  @@unique([ownerId, idempotencyKey])
  @@index([status])
  @@map("orders")
}

enum OrderItemStatus {
  QUEUED_FOR_PRINT
  ROUTED
  PRINTING
  QC
  PASSED
  REWORK
  ESCALATED
  SHIPPED
}

model OrderItem {
  id               String          @id @default(uuid(7)) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  quoteId          String          @map("quote_id") @db.Uuid
  printPartId      String          @map("print_part_id") @db.Uuid
  title            String
  quantity         Int
  unitPriceMinor   Int             @map("unit_price_minor")
  lineTotalMinor   Int             @map("line_total_minor")
  settings         Json
  status           OrderItemStatus @default(QUEUED_FOR_PRINT)
  reworkCount      Int             @default(0) @map("rework_count")
  partnerPrinterId String?         @map("partner_printer_id") @db.Uuid
  partnerItemRef   String?         @map("partner_item_ref")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

/// Append-only.
model OrderEvent {
  seq         BigInt   @id @default(autoincrement())
  orderId     String   @map("order_id") @db.Uuid
  orderItemId String?  @map("order_item_id") @db.Uuid
  type        String
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  data        Json?
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, seq])
  @@map("order_events")
}

model Shipment {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  carrier        String
  trackingNumber String   @unique @map("tracking_number")
  status         String
  events         Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

enum PartnerStatus {
  ACTIVE
  PAUSED
}

model PrintPartner {
  id       String           @id @default(uuid(7)) @db.Uuid
  code     String           @unique
  name     String
  city     String
  country  String
  status   PartnerStatus    @default(ACTIVE)
  isMock   Boolean          @default(true) @map("is_mock")
  printers PartnerPrinter[]

  @@map("print_partners")
}

enum PrinterStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

model PartnerPrinter {
  id           String        @id @default(uuid(7)) @db.Uuid
  partnerId    String        @map("partner_id") @db.Uuid
  name         String
  materials    String[]
  bedMm        Json          @map("bed_mm")
  queueMinutes Int           @default(0) @map("queue_minutes")
  status       PrinterStatus @default(ACTIVE)
  partner      PrintPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_printers")
}

// ───────────────────────────── Platform ─────────────────────────────

/// Append-only.
model AuditLog {
  seq        BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String?
  data       Json?
  ip         String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

model ProviderEventRaw {
  id          String    @id @default(uuid(7)) @db.Uuid
  providerKey String    @map("provider_key")
  eventKey    String    @map("event_key")
  headers     Json
  body        String
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@unique([providerKey, eventKey])
  @@map("provider_events_raw")
}

model StripeEventRaw {
  id          String    @id
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("stripe_events_raw")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  data      Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model IdempotencyRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@map("idempotency_records")
}

model PricingConfig {
  version   Int      @id
  config    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pricing_configs")
}

model GenerationModel {
  code         String  @id
  providerKey  String  @map("provider_key")
  name         String
  capabilities Json
  costs        Json
  active       Boolean @default(true)
  sortOrder    Int     @default(0) @map("sort_order")

  @@map("generation_models")
}

// ───────────── Module 4/5: licenses, catalog parts (addendum slice A) ─────────────

model LicenseTerms {
  id                  String  @id @default(uuid(7)) @db.Uuid
  code                String  @unique
  name                String
  text                String
  attributionTemplate String  @map("attribution_template")
  allowsCommercial    Boolean @map("allows_commercial")
  allowsDerivatives   Boolean @map("allows_derivatives")
  allowsPrintOrder    Boolean @map("allows_print_order")
  /// Personal printing by the downloader only (ALL-RIGHTS-RESERVED).
  personalPrintOnly   Boolean @default(false) @map("personal_print_only")
  isCustom            Boolean @default(false) @map("is_custom")
  ownerId             String? @map("owner_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  modelLicenses       ModelLicense[]

  @@map("license_terms")
}

model ModelLicense {
  id              String       @id @default(uuid(7)) @db.Uuid
  assetId         String       @unique @map("asset_id") @db.Uuid
  licenseId       String       @map("license_id") @db.Uuid
  attributionText String       @map("attribution_text")
  sourceUrl       String?      @map("source_url")
  verifiedBy      String?      @map("verified_by") @db.Uuid
  verifiedAt      DateTime?    @map("verified_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  license         LicenseTerms @relation(fields: [licenseId], references: [id])

  @@map("model_licenses")
}

enum SafetyClass {
  NONE
  COSMETIC
  ENCLOSURE
  SAFETY_CRITICAL
}

enum CatalogStatus {
  DRAFT
  REVIEW
  LIVE
  PAUSED
  REMOVED
  REJECTED
}

/// A catalog part (vehicle fitment library). Safety class is enforced on the server.
model Part {
  id                 String        @id @default(uuid(7)) @db.Uuid
  ownerId            String        @map("owner_id") @db.Uuid
  assetId            String?       @map("asset_id") @db.Uuid
  title              String
  description        String        @default("")
  partNumberText     String?       @map("part_number_text")
  category           String
  safetyClass        SafetyClass   @default(NONE) @map("safety_class")
  licenseId          String?       @map("license_id") @db.Uuid
  status             CatalogStatus @default(DRAFT)
  printOrderAllowed  Boolean       @default(false) @map("print_order_allowed")
  allowedMaterials   String[]      @map("allowed_materials")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status, category])
  @@map("parts")
}
