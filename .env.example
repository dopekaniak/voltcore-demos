# Shapewright environment. Copy to .env for local development.
# Every variable is validated by packages/config/src/env.ts; the services refuse to boot
# and list missing or invalid keys.

NODE_ENV=development
LOG_LEVEL=info

# Required
DATABASE_URL=postgresql://sw:sw@localhost:5432/shapewright
REDIS_URL=redis://localhost:6379
# At least 32 characters. Signs file URLs, sessions, and encrypts TOTP and webhook secrets.
APP_SECRET=dev-change-me-0123456789abcdef0123456789

# Tests use a separate database
TEST_DATABASE_URL=postgresql://sw:sw@localhost:5432/shapewright_test

# Origins
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# The forge sandbox runtime must be a different origin from WEB_ORIGIN (ADR-008)
FORGE_RUNTIME_ORIGIN=http://localhost:3002
API_PORT=4000
TERMS_VERSION=2026-10-draft

# Internal mesh service (Python)
MESH_URL=http://localhost:8000
MESH_SERVICE_TOKEN=dev-mesh-service-token

# Generation provider: mock | live. live needs MESHY_API_KEY.
PROVIDER_MODE=mock
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai/openapi
# Mock latency range in ms (min-max). The spec asks for 8-25 s.
MOCK_PROVIDER_LATENCY_MS=8000-25000

# Forge author: mock only in Release 1
FORGE_AUTHOR=mock
FORGE_BUILD_TIMEOUT_MS=20000
FORGE_BUILD_MEMORY_MB=1024

# Slicer: estimate is the only allowed value until ADR-002b (rule 6)
SLICER_MODE=estimate
# block (default) | allow-dev (local demos and E2E only; refused in production)
ESTIMATE_ORDERS=block

# Payments: mock | stripe-test. stripe-test needs both Stripe keys.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_STRIPE_WEBHOOK_SECRET=whsec_mock_local_development_only
STRIPE_TAX_ENABLED=false

PARTNER_MODE=mock

# Storage: fs (default, no object store needed) | s3 (MinIO in compose)
STORAGE_DRIVER=fs
STORAGE_DIR=./var/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mail: log (default) | smtp (Mailpit: smtp://localhost:1025) | memory (tests)
MAIL_DRIVER=log
SMTP_URL=
MAIL_FROM="Shapewright <no-reply@shapewright.local>"

RATE_LIMIT_USER_PER_MIN=60
# Refunds above this amount (minor units) need a second admin approval
REFUND_SECOND_APPROVAL_MINOR=10000
# Comma-separated emails that become ADMIN on first sign-in (local only)
BOOTSTRAP_ADMIN_EMAILS=
