# Copy to .env and fill in. Never commit .env.

# LLM routing (local OmniRoute proxy)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# MCP connectors (referenced by .mcp.json)
FIRECRAWL_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Trading safety caps (quant bots). The Polymarket->Kalshi copy bot has its full template in
# trading/polymarket_kalshi_copybot/.env.example; Kalshi keys go there, never in code.
MODE=paper
MAX_RISK_PCT_PER_TRADE=1
DAILY_LOSS_LIMIT_PCT=3
MAX_SLIPPAGE=0.005

# Lead scraper (scripts/camoufox_lead_scraper.py)
N8N_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/local-leads
CAMOUFOX_PROXY=
